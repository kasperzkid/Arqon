# Arqon — environment configuration.
# Copy this file to `.env` (it is git-ignored) and adjust values as needed.

# Application
ENVIRONMENT=development
APP_NAME=Arqon
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# CORS (allow the local frontend; the Vite dev server usually runs on 5173/5174)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Database (SQLite for local development; PostgreSQL later)
DATABASE_URL=sqlite:///./arqon_dev.db

# Blockchain (public mainnet-beta endpoint by default — no key needed)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_REQUEST_TIMEOUT=10.0

# Frontend (Vite dev server)
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://127.0.0.1:8000
